<resources>
    <style name="Base.AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/surface</item>
    </style>
    <!-- Android 10+ adds android:isLightTheme (values-v29). -->
    <style name="AppTheme" parent="Base.AppTheme" />
    <bool name="light_mode">true</bool>
    <color name="bg">#111111</color>
    <color name="accent">#004225</color>
    <color name="surface">#1b1b1b</color>
</resources>
